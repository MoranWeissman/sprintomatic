{
  "name": "sprintomatic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal agile workspace — Azure DevOps + GitHub integration, time tracking, ceremony support.",
  "scripts": {
    "dev": "vite",
    "start": "vite build && tsx server/serve.ts",
    "mcp": "tsx mcp/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release-scan": "tsx scripts/release-scan.ts",
    "export": "tsx scripts/export.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.4.6",
    "markdown-it": "^14.2.0",
    "node-ical": "^0.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
