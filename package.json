{
  "name": "sprintomatic",
  "version": "0.1.0",
  "type": "module",
  "description": "Keeps your Azure DevOps sprint up to date while you work with an AI assistant. An MCP server plus a local dashboard.",
  "keywords": [
    "mcp",
    "azure-devops",
    "sprint",
    "claude",
    "agile"
  ],
  "bin": {
    "sprintomatic": "dist-node/cli.js"
  },
  "files": [
    "dist/",
    "dist-node/"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite build && tsx server/serve.ts",
    "mcp": "tsx mcp/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release-scan": "tsx scripts/release-scan.ts",
    "export": "tsx scripts/export.ts",
    "setup": "tsx scripts/setup.ts",
    "build:cli": "rm -rf dist-node && esbuild scripts/cli.ts --bundle --platform=node --format=esm --splitting --packages=external --target=node24 --outdir=dist-node",
    "prepublishOnly": "npm run typecheck && npm test && vite build && npm run build:cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "node-ical": "^0.26.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.4.6",
    "esbuild": "^0.25.12",
    "markdown-it": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
